<Window x:Class="Vocabulary.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LexiPane">
<NavigationView x:Name="Nav" PaneTitle="LexiPane" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" OpenPaneLength="200" ExpandedModeThresholdWidth="820" CompactModeThresholdWidth="600" IsPaneOpen="True">
 <NavigationView.MenuItems>
  <NavigationViewItem Content="今日学习" Tag="today"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;"/></NavigationViewItem.Icon></NavigationViewItem>
  <NavigationViewItem Content="挑战" Tag="challenges"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7C1;"/></NavigationViewItem.Icon></NavigationViewItem>
  <NavigationViewItem Content="词库" Tag="library"><NavigationViewItem.Icon><FontIcon Glyph="&#xE82D;"/></NavigationViewItem.Icon></NavigationViewItem>
  <NavigationViewItem Content="生词本" Tag="notebook"><NavigationViewItem.Icon><FontIcon Glyph="&#xE734;"/></NavigationViewItem.Icon></NavigationViewItem>
  <NavigationViewItem Content="遗忘词" Tag="forgotten"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;"/></NavigationViewItem.Icon></NavigationViewItem>
  <NavigationViewItem Content="学习统计" Tag="history"><NavigationViewItem.Icon><PathIcon Data="M2,10 H5 V18 H2 Z M8,3 H11 V18 H8 Z M14,7 H17 V18 H14 Z"/></NavigationViewItem.Icon></NavigationViewItem>
 </NavigationView.MenuItems>
 <NavigationView.FooterMenuItems><NavigationViewItem Content="设置" Tag="settings" Icon="Setting"/></NavigationView.FooterMenuItems>
 <Grid Padding="28,18,28,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <InfoBar x:Name="ShellStatus" Severity="Informational" IsClosable="False" Title="桌面正在恢复" Message="卡片暂时以普通窗口显示。"/>
  <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="Body" Spacing="18" MaxWidth="980" HorizontalAlignment="Stretch" Padding="0,0,6,8"/>
  </ScrollViewer>
 </Grid>
</NavigationView>
</Window>
